{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APRSWolf",
  "version": "1.0.4",
  "identifier": "com.jperry.aprswolf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "APRSWolf",
        "width": 1100,
        "height": 740,
        "minWidth": 820,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "APRS messaging over KISS/AGW TCP and APRS-IS",
    "longDescription": "APRSWolf is a desktop client for APRS messaging over KISS/AGW TCP (Dire Wolf compatible) and APRS-IS.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"]
      }
    }
  }
}
